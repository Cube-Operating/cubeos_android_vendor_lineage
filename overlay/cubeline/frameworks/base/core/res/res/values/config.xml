<!-- CubeOS: Phone and Messages (packages/apps/CubeOSApps, see config/cubeline.mk) hold the
     dialer and SMS roles from first boot. RoleManager takes the default holders of
     android.app.role.DIALER and android.app.role.SMS from these, in place of
     com.android.dialer / com.android.messaging, which CubePhone and CubeMessages override. -->
<resources>
    <string name="config_defaultDialer" translatable="false">org.cubeapp.phone</string>
    <string name="config_defaultSms" translatable="false">org.cubeapp.messages</string>
</resources>
