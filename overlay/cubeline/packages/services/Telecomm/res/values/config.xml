<!-- CubeOS: Telecom's "system dialer" is Phone (org.cubeapp.phone), not com.android.dialer,
     which CubePhone overrides. Telecom falls back to the system dialer's InCallService when
     the default dialer can't take a call (emergency calls, a crashed third-party dialer) and
     reports it from TelecomManager.getSystemDialerPackage(). -->
<resources>
    <string name="ui_default_package" translatable="false">org.cubeapp.phone</string>
    <string name="dialer_default_class" translatable="false">org.cubeapp.phone.MainActivity</string>
</resources>
